[Unit]
Description=Heartfulness Remote: rebuild container images with patched base images
Documentation=file://@REPO_DIR@/deploy/rebuild.sh
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash @REPO_DIR@/deploy/rebuild.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
