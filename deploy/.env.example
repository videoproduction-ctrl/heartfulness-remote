# deploy/.env is GENERATED ON THE SERVER by deploy/provision.sh and never
# leaves it (it is git-ignored). This file only documents the variables.
# Never put real values in this example file.

# Public address of the server (a free DuckDNS or deSEC name works).
HR_DOMAIN=heartfulness-remote.duckdns.org
HR_ORIGIN=https://heartfulness-remote.duckdns.org

# coturn shared secret for time-limited TURN credentials.
# Generated with: openssl rand -hex 32
HR_TURN_SECRET=<generated-on-the-server>

# The server's public IPv4 address (from `ip -4 route get 1.1.1.1`, or the
# address given to scripts/deploy-server.sh). Used by coturn.
HR_EXTERNAL_IP=<detected-on-the-server>

# (HR_TRUSTED_PROXIES is set in docker-compose.yml, next to caddy's fixed
# address on the internal network: only caddy may set X-Forwarded-For.)

# Optional: e-mail for Let's Encrypt expiry notices (may stay empty).
ACME_EMAIL=

# Optional: allow only these Macs (comma-separated base64url host keys) to
# claim this server or join the account; empty = any Mac (each still needs
# the code shown on its screen). Keys are shown by `heartfulness-server status`.
HR_HOST_PUBKEY=
