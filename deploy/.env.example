# deploy/.env is GENERATED ON THE SERVER by deploy/provision.sh and never
# leaves it (it is git-ignored). This file only documents the variables.
# Never put real values in this example file.

# Public address of the server (a free deSEC/DuckDNS name works).
HR_DOMAIN=heartfulness-remote.dedyn.io
HR_ORIGIN=https://heartfulness-remote.dedyn.io

# coturn shared secret for time-limited TURN credentials.
# Generated with: openssl rand -hex 32
HR_TURN_SECRET=<generated-on-the-server>

# The server's public IPv4 address (from `ip -4 route get 1.1.1.1`).
HR_EXTERNAL_IP=<detected-on-the-server>

# Caddy's fixed address on the internal Docker network (docker-compose.yml);
# only it may set X-Forwarded-For.
HR_TRUSTED_PROXIES=172.30.77.2/32

# Optional: e-mail for Let's Encrypt expiry notices (may stay empty).
ACME_EMAIL=

# Optional: pin the Mac's host key (base64url) so no other Mac can ever claim
# this server. Shown by `heartfulness-server status` after setup.
HR_HOST_PUBKEY=
